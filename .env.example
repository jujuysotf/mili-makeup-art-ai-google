# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Host URL of the applet.
APP_URL="MY_APP_URL"

# Google Identity Services Client ID (reutilizado de yourplace-peluqueria)
# Permite autenticación de clientas con Google
VITE_GOOGLE_CLIENT_ID="TU_GOOGLE_CLIENT_ID.apps.googleusercontent.com"

# Google Calendar Service Account (reutilizado de yourplace-peluqueria)
# Cuenta de calendario compartida: jujuysotf@gmail.com
GOOGLE_CALENDAR_ID="jujuysotf@gmail.com"

# Opción A: JSON completo de la Service Account en una sola línea
GOOGLE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...@....iam.gserviceaccount.com"}'

# Opción B: Credenciales separadas
GOOGLE_CLIENT_EMAIL="tu-service-account@tu-proyecto.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Puerto de ejecución local (default 3000)
PORT="3000"

# Mini gestión de reels (URL: /#gestion-reels)
# PIN de acceso (recomendado: 4 dígitos). Solo en el servidor, nunca VITE_*.
REELS_ADMIN_PASSWORD="1234"

# En Vercel, para que "Guardar" persista: Blob Store → pestaña ".env.local"
# → copiar EXACTAMENTE esta variable (no alcanza con BLOB_STORE_ID):
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
